# Copy to .env and fill in values. .env is gitignored and never committed.

# --- Used by docker-compose to create the local database ---
POSTGRES_DB=claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=change-me
DB_HOST_PORT=5434

# --- Used by the Spring Boot app (on AWS these come from the ECS task definition) ---
DB_URL=jdbc:postgresql://localhost:5434/claims
DB_USERNAME=claims
DB_PASSWORD=change-me
